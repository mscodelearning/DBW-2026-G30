<!DOCTYPE html>

<html lang="pt-PT">
    <head>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="/css/style.css">
        <title>Skriven</title>
        
    </head>
<body>
    <div>
        <%- include("partials/header") %>
        
        <div class="botao-voltar-container">
            <img src="/images/botao-sair.png" alt="voltar">
            <div class="overlay-text">Voltar</div>
            <a href="/"></a>
        </div>
        <div class="login-container">
            <img src="/images/fundo-estrutura-login.png" alt="fundo-login" class="fundo-login">
            <div class="user-icon-container">
                <img src="/symbols/user-icon-2.png" alt="user-icon" class="user-icon-img">
            </div>     
             <div id="form-area-login">
                <form action="/login" method="POST">
                    <input type="text" name="username" placeholder="Username" required class="login-input">
                    <input type="password" name="password" placeholder="Password" required class="login-input">

                    <% if (typeof error !== "undefined" && error) { %>
                      <p class="login-error"><%= error %></p>
                    <% } %>

                    <div class="botao-login-container">
                        <img src="/images/botao-login.png" alt="botao-login" class="botao-login">

                        <button type="submit" id="login-link" style="background: none; border: none; padding: 0;">
                            <div class="botao-login-verde">
                                <img src="/images/retangulo-verde-botao-login.png" alt="botao-login-verde" class="botao-login-verde">
                            </div>
                            <div class="overlay-text-login">Login</div>
                        </button>
                    </div>
                </form>
            </div>
            <div class="login-signup">
                <a href="/signup">Sign Up</a>
            </div>
        </div>
    </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js" defer></script>
</body>

</html>
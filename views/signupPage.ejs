<!DOCTYPE html>

<html lang="pt-PT">
    <head>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="/css/style.css">
        <title>Skriven</title>
    </head>
<body>
    <div>
        <%- include("partials/header") %>
        
        <div class="botao-voltar-container">
            <img src="/images/botao-sair.png" alt="voltar">
            <div class="overlay-text">Voltar</div>
            <a href="/login"></a>
        </div>
        
        <div class="caixa-fundo-container">
            <h1>Registo</h1>

        <div class="user-icon2-container">
                <img id="perfil-img" src="/symbols/user-icon-2.png" alt="user-icon"> 
        </div>
            <div id="form-area-signup">
              <form action="/signup" method="POST">
                <input type="text" name="username" placeholder="Username" required class="caixa-texto">
                <input type="text" name="nickname" placeholder="Nickname" required class="caixa-texto">
                <input type="password" name="password" placeholder="Password" required class="caixa-texto">

                <% if (typeof error !== "undefined" && error) { %>
                  <p class="signup-erro"><%= error %></p>
                <% } %>

                <div class="botao-signup-container">
                    <img src="/images/botao-login.png" alt="botao-signup">

                    <button type="submit" id="signup-link" style="background: none; border: none; padding: 0;">
                        <div class="fundo-verde-botao-signup">
                            <div class="overlay-text-signup">SIGN UP</div>
                            <img src="/images/retangulo-verde-botao-login.png" alt="fundo-botao-signup">
                        </div>
                    </button>

                </div>
              </form>
            </div>
            
        </div>
    </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/script.js" defer></script>
<script src="/js/formSignupPg.js" defer></script>

</body>

</html>
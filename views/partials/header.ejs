<header>
            <nav class="barra-navegacao">

                <img src="/images/logo-skriven.png" alt="Logo" class="nav-logo">

                <button class="botao-menu border-0 bg-transparent p-0" type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#menuLateral" aria-controls="menuLateral">
                    <img src="/images/botao-menu-perfil.png" alt="botao-menu" class="botao-menu">
                </button>
                <div class="dropdown user-dropdown">
                    <a href="#"
                    class="d-flex align-items-center text-decoration-none"
                    data-bs-toggle="dropdown" aria-expanded="false">
                        <img class="perfil" src="/images/botao-perfil.png" alt="perfil">
                        <img class="user-icon" src="<%= currentUser ? (currentUser.avatar || '/symbols/Union-user-icon.png') : '/symbols/Union-user-icon.png' %>" alt="user">
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end p-3 shadow">
                        
                        <li class="d-flex align-items-center mb-3">
                        
                            <img src="<%= currentUser ? (currentUser.avatar || '/symbols/Union-user-icon.png') : '/symbols/Union-user-icon.png' %>" alt="user" width="60" height="60" class="rounded-circle me-3">

                            <h6 class="mb-0 "><%= currentUser ? currentUser.nickname : "Utilizador" %></h6>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <% if (isAuthenticated) { %>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="/perfilPage">
                                <img src="/symbols/Union-user-icon.png" alt="" width="35" height="35" class="rounded-circle bg-light p-1">
                                <span class="flex-grow-1">Editar Perfil</span>
                                <span>></span>
                            </a>
                            <% } else { %>
                                <a href="#"></a>
                            <% } %>
                        </li>

                        <li>
                            <% if (isAuthenticated) { %>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="/tutorial">
                                <img src="/symbols/simbolo-interrogacao.png" alt="" width="35" height="35" class="rounded-circle bg-light p-1">
                                <span class="flex-grow-1">Tutorial</span>
                                <span>></span>
                            </a>
                            <% } else { %>
                                <a href="#"></a>
                            <% } %>
                        </li>

                        <li>
                            <% if (isAuthenticated) { %>
                            <a class="dropdown-item d-flex align-items-center gap-2" href="#">
                                <img src="/symbols/simbolo-logout.png" alt="" width="35" height="35" class="rounded-circle bg-light p-1">
                                <form action="/logout" method="POST">
                                    <button type="submit" class="dropdown-item logout-btn">
                                        <span>Logout</span>
                                        <span class="seta">></span>
                                    </button>
                                </form>
                    
                            </a>
                            <% } else { %>
                                <a href="#"></a>
                            <% } %>
                        </li>
                    </ul>
                </div>

                <div class="offcanvas offcanvas-start" tabindex="-1" id="menuLateral" aria-labelledby="menuLateralLabel">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title" id="menuLateralLabel">Menu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar"></button>
                    </div>

                    <div class="offcanvas-body">
                        <% if (isAuthenticated) { %>
                        <a href="/perfilPage" class="d-block text-white text-decoration-none mb-3">Perfil</a>
                        <a href="/" class="d-block text-white text-decoration-none mb-3">Página inicial</a>
                        <a href="/tutorial" class="d-block text-white text-decoration-none mb-3">Tutorial</a>
                        <a href="/selectMultiplayerPage" class="d-block text-white text-decoration-none mb-3">Multiplayer</a>
                        <a href="/paginaSalasPublicas" class="d-block text-white text-decoration-none mb-3">Salas Públicas</a>
                        <a href="/AboutPg" class="d-block text-white text-decoration-none mb-3">About</a>
                        <form action="/logout" method="POST" class="logout-form">
                            <button type="submit" class="logout-link">Logout</button>
                        </form>
                        <% } else { %>
                            <a href="/login">Login</a>
                            <a href="/signup">Sign Up</a>
                        <% } %>
                    </div>
                </div>
            </nav>
        </header>